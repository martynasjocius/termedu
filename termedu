#!/usr/bin/env python3
from __future__ import annotations

from collections.abc import Sequence
from pathlib import Path
import sys


def _project_src_dir() -> Path:
    return Path(__file__).resolve().parent / "src"


def _ensure_project_src_on_path() -> None:
    src_dir = _project_src_dir()
    src_dir_text = str(src_dir)

    if src_dir_text not in sys.path:
        sys.path.insert(0, src_dir_text)


_ensure_project_src_on_path()

from termedu.cli import main as packaged_main


def main(argv: Sequence[str] | None = None) -> int:
    return packaged_main(argv)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
